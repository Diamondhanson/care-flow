# CareFlow environment — copy to `.env.local` and fill in.
#
# Local development (Supabase CLI + Docker):
#   1. supabase start
#   2. supabase status   → copy the URL + keys below
#
# Production (hosted Supabase project): use the project's URL + keys from the
# Supabase dashboard → Settings → API.

# Browser-safe (shipped to the client; RLS gates all data access).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. Used by server actions
# (staff-login provisioning) and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=
